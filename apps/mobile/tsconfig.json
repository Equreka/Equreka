{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true
	},
	"include": ["**/*.ts", "**/*.tsx", "expo-env.d.ts"],
	"exclude": ["node_modules", "dist", ".expo", "scripts"]
}
