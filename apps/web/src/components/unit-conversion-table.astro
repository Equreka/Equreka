---
import { type Locale, localizedName, t } from '@equreka/core/i18n';
import { formatSigFigs } from '@equreka/engine/format';
import { localePath } from '../lib/locale-paths';
import { unitRegistry } from '../lib/server/engine-registry';
import { renderSymbolHtml } from '../lib/tex';
import CollapseCard from './collapse-card.astro';

interface Props {
	unitSlug: string;
	locale?: Locale;
}

const { unitSlug, locale = 'en' } = Astro.props;
const unit = unitRegistry.getUnit(unitSlug);
const targets =
	unit === undefined
		? []
		: unitRegistry
				.compatibleUnits(unitSlug)
				.filter((target) => target.slug !== unitSlug)
				.sort((a, b) => localizedName(a, locale).localeCompare(localizedName(b, locale), locale));
const rows = targets.flatMap((target) => {
	const converted = unitRegistry.convert(1, unitSlug, target.slug);
	return converted.ok
		? [
				{
					target,
					value: formatSigFigs(converted.value),
					exact: unitRegistry.isExactPath(unitSlug, target.slug),
				},
			]
		: [];
});
---

{
	unit !== undefined && rows.length > 0 && (
		<CollapseCard headingId="conversions-heading" title={t(locale, 'conversions.title')}>
			<p class="eq-card-note">{t(locale, 'conversions.lead', { symbol: unit.symbolText })}</p>
			<div class="eq-table-wrap">
				<table class="eq-table-data">
					<thead>
						<tr>
							<th scope="col">{t(locale, 'table.unit')}</th>
							<th scope="col">{t(locale, 'table.symbol')}</th>
							<th scope="col" class="eq-cell-numeric">
								{t(locale, 'conversions.header', { symbol: unit.symbolText })}
							</th>
						</tr>
					</thead>
					<tbody>
						{rows.map((row) => (
							<tr>
								<td>
									<a class="eq-link" href={localePath(locale, `/units/${row.target.slug}/`)}>
										{localizedName(row.target, locale)}
									</a>
								</td>
								<td class="eq-cell-symbol">
									<span set:html={renderSymbolHtml(row.target.symbolTex, row.target.symbolText)} />
								</td>
								<td class="eq-cell-numeric eq-cell-value">
									{row.exact ? '' : '≈ '}
									{row.value} {row.target.symbolText}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</CollapseCard>
	)
}
