---
import { type Locale, localizedName, t } from '@equreka/core/i18n';
import { formatSigFigs } from '@equreka/engine/format';
import { localePath } from '../lib/locale-paths';
import { unitRegistry } from '../lib/server/engine-registry';
import { renderSymbolHtml } from '../lib/tex';

interface Props {
	unitSlug: string;
	locale?: Locale;
}

const { unitSlug, locale = 'en' } = Astro.props;
const unit = unitRegistry.getUnit(unitSlug);
const targets =
	unit === undefined
		? []
		: unitRegistry
				.compatibleUnits(unitSlug)
				.filter((target) => target.slug !== unitSlug)
				.sort((a, b) => localizedName(a, locale).localeCompare(localizedName(b, locale), locale));
const rows = targets.flatMap((target) => {
	const converted = unitRegistry.convert(1, unitSlug, target.slug);
	return converted.ok
		? [
				{
					target,
					value: formatSigFigs(converted.value),
					exact: unitRegistry.isExactPath(unitSlug, target.slug),
				},
			]
		: [];
});
---

{
	unit !== undefined && rows.length > 0 && (
		<section aria-labelledby="conversions-heading" class="mt-10">
			<h2 id="conversions-heading" class="text-2xl font-semibold">
				{t(locale, 'conversions.title')}
			</h2>
			<p class="mt-1 text-sm text-ink-muted">
				{t(locale, 'conversions.lead', { symbol: unit.symbolText })}
			</p>
			<div class="mt-4 overflow-x-auto rounded-lg border border-border">
				<table class="w-full border-collapse bg-surface text-left">
					<thead>
						<tr class="border-b border-border text-sm text-ink-muted">
							<th scope="col" class="px-4 py-2 font-medium">
								{t(locale, 'table.unit')}
							</th>
							<th scope="col" class="px-4 py-2 font-medium">
								{t(locale, 'table.symbol')}
							</th>
							<th scope="col" class="px-4 py-2 font-medium">
								{t(locale, 'conversions.header', { symbol: unit.symbolText })}
							</th>
						</tr>
					</thead>
					<tbody>
						{rows.map((row) => (
							<tr class="border-b border-border last:border-b-0">
								<td class="px-4 py-2">
									<a
										class="text-accent hover:underline"
										href={localePath(locale, `/units/${row.target.slug}/`)}
									>
										{localizedName(row.target, locale)}
									</a>
								</td>
								<td class="px-4 py-2">
									<span set:html={renderSymbolHtml(row.target.symbolTex, row.target.symbolText)} />
								</td>
								<td class="px-4 py-2 font-mono text-sm">
									{row.exact ? '' : '≈ '}
									{row.value} {row.target.symbolText}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)
}
