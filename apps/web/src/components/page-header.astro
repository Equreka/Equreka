---
/**
 * Legacy PageHeader: full-bleed accent band (render it into the layout's
 * `hero` slot) holding only the uppercase label, the page's only h1 and
 * round actions (`actions` slot), as the original did. `accent` is the
 * slug class (`type-units`, `cat-physics`) that colors the band. The
 * optional lead (default slot) is v2 content the original band never
 * carried, so it renders below the band, in the page container. `entry`
 * marks an entry page, whose band sat inside the original's `main.data`
 * and took its fluid font size.
 */
interface Props {
	label: string;
	labelHref?: string | undefined;
	title: string;
	accent?: string | undefined;
	entry?: boolean;
}

const { label, labelHref, title, accent, entry = false } = Astro.props;
---

<header class:list={['eq-accent-panel', 'eq-page-header', entry && 'eq-data', accent]}>
	<div class="eq-container">
		<div class="eq-page-header-row">
			<div class="eq-page-header-main">
				{
					labelHref === undefined ? (
						<p class="eq-page-header-label">{label}</p>
					) : (
						<a class="eq-page-header-label eq-page-header-label-link" href={labelHref}>
							{label}
						</a>
					)
				}
				<h1 class="eq-page-header-title">{title}</h1>
			</div>
			{
				Astro.slots.has('actions') && (
					<div class="eq-page-actions">
						<slot name="actions" />
					</div>
				)
			}
		</div>
	</div>
</header>
{
	Astro.slots.has('default') && (
		<div class="eq-container">
			<div class="eq-page-header-lead">
				<slot />
			</div>
		</div>
	)
}
