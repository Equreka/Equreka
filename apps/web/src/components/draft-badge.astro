---
import { type Locale, t } from '@equreka/core/i18n';
import type { EditorialStatus } from '@equreka/schema';
import { isDraft } from '../lib/entry-meta';

interface Props {
	locale: Locale;
	status: EditorialStatus | undefined;
}

const { locale, status } = Astro.props;
---

{
	isDraft(status) && (
		<span
			class="rounded-full border border-border px-2.5 py-0.5 text-ink-muted"
			title={t(locale, 'badge.draftHint')}
			data-status="draft"
		>
			{t(locale, 'badge.draft')}
		</span>
	)
}
