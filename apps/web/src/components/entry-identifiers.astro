---
import { type Locale, t } from '@equreka/core/i18n';
import type { ExternalIds } from '@equreka/schema';
import { externalLinks } from '../lib/entry-meta';

interface Props {
	locale: Locale;
	externalIds: ExternalIds | undefined;
}

const { locale, externalIds } = Astro.props;
const links = externalLinks(externalIds);
---

{
	links.length > 0 && (
		<p class="mt-3 flex flex-wrap items-center gap-3 text-sm text-ink-muted">
			<span>{t(locale, 'entry.identifiers')}</span>
			{links.map((link) => (
				<a class="text-accent hover:underline" href={link.href} rel="external noopener">
					{link.label}
				</a>
			))}
		</p>
	)
}
