---
import { getCollection } from 'astro:content';
import { type Locale, localizedName, t } from '@equreka/core/i18n';
import { type BranchGroup, branchesOfCategory, groupByBranch } from '@equreka/core/taxonomy';
import BaseLayout from '../layouts/base-layout.astro';
import { CATEGORY_TEXT } from '../lib/category-styles';
import { asCategory, asUnit } from '../lib/collections';
import { localePath } from '../lib/locale-paths';
import { branchRecords } from '../lib/server/taxonomy';
import { renderSymbolHtml } from '../lib/tex';
import { symbolTextOf } from '../lib/unit-symbol';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const categories = (await getCollection('categories'))
	.map((entry) => ({ slug: entry.id, ...asCategory(entry.data) }))
	.sort((a, b) => a.order - b.order);
const units = (await getCollection('units')).map((entry) => ({
	slug: entry.id,
	...asUnit(entry.data),
}));

const byName = (
	a: { name: { en: string; es?: string } },
	b: { name: { en: string; es?: string } },
) => localizedName(a, locale).localeCompare(localizedName(b, locale), locale);

const branches = await branchRecords();

type ListedUnit = (typeof units)[number];

function branchSections(slug: string, group: BranchGroup<ListedUnit>) {
	const branch = group.branch === null ? undefined : branches[group.branch];
	return {
		id: `${slug}-${group.branch ?? 'general'}`,
		title: branch === undefined ? t(locale, 'branch.general') : localizedName(branch, locale),
		href: group.branch === null ? undefined : `/branches/${group.branch}/`,
		units: group.entries,
	};
}

const grouped = categories
	.map((category) => {
		const members = units.filter((unit) => unit.categories.includes(category.slug)).sort(byName);
		return {
			slug: category.slug,
			title: localizedName(category, locale),
			count: members.length,
			sections: groupByBranch(members, branchesOfCategory(branches, category.slug)).map((group) =>
				branchSections(category.slug, group),
			),
		};
	})
	.filter((group) => group.count > 0);

const ungrouped = units
	.filter((unit) => !categories.some((category) => unit.categories.includes(category.slug)))
	.sort(byName);
if (ungrouped.length > 0) {
	grouped.push({
		slug: 'other',
		title: t(locale, 'group.other'),
		count: ungrouped.length,
		sections: [branchSections('other', { branch: null, entries: ungrouped })],
	});
}
---

<BaseLayout
	title={`${t(locale, 'collection.units')} — Equreka`}
	description={t(locale, 'meta.units')}
	locale={locale}
>
	<h1 class="text-3xl font-bold tracking-tight">{t(locale, 'collection.units')}</h1>
	<p class="mt-2 text-ink-muted">{t(locale, 'units.lead', { count: units.length })}</p>
	{
		grouped.map((group) => (
			<section aria-labelledby={`${group.slug}-heading`} class="mt-10">
				<h2
					id={group.slug}
					class={`text-2xl font-semibold ${CATEGORY_TEXT[group.slug] ?? 'text-ink'}`}
				>
					<span id={`${group.slug}-heading`}>{group.title}</span>
					<span class="ml-2 text-sm font-normal text-ink-muted">{group.count}</span>
				</h2>
				{group.sections.map((section) => (
					<>
						{(section.href !== undefined || group.sections.length > 1) && (
							<h3 id={section.id} class="mt-6 text-lg font-medium">
								{section.href !== undefined ? (
									<a class="hover:underline" href={localePath(locale, section.href)}>
										{section.title}
									</a>
								) : (
									section.title
								)}
								<span class="ml-2 text-sm font-normal text-ink-muted">{section.units.length}</span>
							</h3>
						)}
						<div class="mt-4 overflow-x-auto rounded-lg border border-border">
							<table class="w-full border-collapse bg-surface text-left">
								<thead>
									<tr class="border-b border-border text-sm text-ink-muted">
										<th scope="col" class="w-24 px-4 py-2 font-medium">
											{t(locale, 'table.symbol')}
										</th>
										<th scope="col" class="px-4 py-2 font-medium">
											{t(locale, 'table.name')}
										</th>
										<th scope="col" class="px-4 py-2 font-medium">
											{t(locale, 'table.system')}
										</th>
									</tr>
								</thead>
								<tbody>
									{section.units.map((unit) => (
										<tr class="border-b border-border last:border-b-0">
											<td
												class="px-4 py-2"
												set:html={renderSymbolHtml(unit.symbol.tex, symbolTextOf(unit))}
											/>
											<td class="px-4 py-2">
												<a
													class="text-accent hover:underline"
													href={localePath(locale, `/units/${unit.slug}/`)}
												>
													{localizedName(unit, locale)}
												</a>
											</td>
											<td class="px-4 py-2 text-sm text-ink-muted">
												{t(locale, `system.${unit.system}`)}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</>
				))}
			</section>
		))
	}
</BaseLayout>
