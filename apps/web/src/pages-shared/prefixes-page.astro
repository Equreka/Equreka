---
import { getCollection } from 'astro:content';
import { type Locale, localizedName, t } from '@equreka/core/i18n';
import PathContextBar from '../islands/path-context-bar';
import BaseLayout from '../layouts/base-layout.astro';
import { asPrefix } from '../lib/collections';
import { formatFullPrecision, powerOfTenExponent, toSuperscript } from '../lib/notation';
import { renderSymbolHtml } from '../lib/tex';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const prefixes = (await getCollection('prefixes')).map((entry) => {
	const prefix = asPrefix(entry.data);
	return {
		slug: entry.id,
		...prefix,
		exponent: powerOfTenExponent(prefix.value),
	};
});

const byMagnitudeDesc = (a: { exponent: number | null }, b: { exponent: number | null }) =>
	(b.exponent ?? 0) - (a.exponent ?? 0);

const multiples = prefixes.filter((prefix) => (prefix.exponent ?? 0) >= 0).sort(byMagnitudeDesc);
const submultiples = prefixes.filter((prefix) => (prefix.exponent ?? 0) < 0).sort(byMagnitudeDesc);

const tables = [
	{ id: 'multiples', title: t(locale, 'prefixes.multiples'), rows: multiples },
	{ id: 'submultiples', title: t(locale, 'prefixes.submultiples'), rows: submultiples },
];
---

<BaseLayout
	title={`${t(locale, 'collection.prefixes')} — Equreka`}
	description={t(locale, 'meta.prefixes')}
	locale={locale}
>
	<PathContextBar client:idle locale={locale} />
	<h1 class="text-3xl font-bold tracking-tight">{t(locale, 'collection.prefixes')}</h1>
	<p class="mt-2 max-w-2xl text-ink-muted">
		{t(locale, 'prefixes.lead', { count: prefixes.length })}
	</p>
	{
		tables.map((table) => (
			<section aria-labelledby={`${table.id}-heading`} class="mt-10">
				<h2 id={`${table.id}-heading`} class="text-2xl font-semibold">
					{table.title}
					<span class="ml-2 text-sm font-normal text-ink-muted">{table.rows.length}</span>
				</h2>
				<div class="mt-4 overflow-x-auto rounded-lg border border-border">
					<table class="w-full border-collapse bg-surface text-left">
						<thead>
							<tr class="border-b border-border text-sm text-ink-muted">
								<th scope="col" class="w-24 px-4 py-2 font-medium">
									{t(locale, 'table.symbol')}
								</th>
								<th scope="col" class="px-4 py-2 font-medium">
									{t(locale, 'table.name')}
								</th>
								<th scope="col" class="px-4 py-2 font-medium">
									{t(locale, 'table.value')}
								</th>
							</tr>
						</thead>
						<tbody>
							{table.rows.map((prefix) => (
								<tr id={prefix.slug} class="border-b border-border last:border-b-0">
									<td
										class="px-4 py-2"
										set:html={renderSymbolHtml(
											prefix.symbol.tex,
											prefix.symbol.text ?? prefix.symbol.tex,
										)}
									/>
									<td class="px-4 py-2">{localizedName(prefix, locale)}</td>
									<td class="px-4 py-2 font-mono text-sm">
										{prefix.exponent === null
											? formatFullPrecision(prefix.value)
											: `10${toSuperscript(prefix.exponent)}`}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		))
	}
</BaseLayout>
