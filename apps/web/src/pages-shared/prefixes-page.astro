---
import { getCollection } from 'astro:content';
import { type Locale, localizedName, t } from '@equreka/core/i18n';
import AbbrLabel from '../components/abbr-label.astro';
import MathValue from '../components/math-value.astro';
import PageHeader from '../components/page-header.astro';
import PathContextBar from '../islands/path-context-bar';
import BaseLayout from '../layouts/base-layout.astro';
import { asPrefix } from '../lib/collections';
import { formatFullPrecision, powerOfTenExponent } from '../lib/notation';
import { renderSymbolHtml } from '../lib/tex';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;

/**
 * 10ⁿ written out in full, as the original's "Number" column printed it
 * (`toFixed()`): 1 followed by n zeros, or n−1 zeros after the point.
 */
function plainPowerOfTen(exponent: number): string {
	return exponent >= 0 ? `1${'0'.repeat(exponent)}` : `0.${'0'.repeat(-exponent - 1)}1`;
}

const prefixes = (await getCollection('prefixes')).map((entry) => {
	const prefix = asPrefix(entry.data);
	const exponent = powerOfTenExponent(prefix.value);
	return {
		slug: entry.id,
		...prefix,
		exponent,
		number: exponent === null ? formatFullPrecision(prefix.value) : plainPowerOfTen(exponent),
	};
});

const byMagnitudeDesc = (a: { exponent: number | null }, b: { exponent: number | null }) =>
	(b.exponent ?? 0) - (a.exponent ?? 0);

const multiples = prefixes.filter((prefix) => (prefix.exponent ?? 0) >= 0).sort(byMagnitudeDesc);
const submultiples = prefixes.filter((prefix) => (prefix.exponent ?? 0) < 0).sort(byMagnitudeDesc);

const tables = [
	{ id: 'multiples', title: t(locale, 'prefixes.multiples'), rows: multiples },
	{ id: 'submultiples', title: t(locale, 'prefixes.submultiples'), rows: submultiples },
];
---

<BaseLayout
	title={`${t(locale, 'collection.prefixes')} — Equreka`}
	description={t(locale, 'meta.prefixes')}
	locale={locale}
>
	<PageHeader
		slot="hero"
		label={t(locale, 'design.content.header.category')}
		title={t(locale, 'collection.prefixes')}
		accent="type-prefixes"
	/>
	<PathContextBar slot="context" client:idle locale={locale} />
	<div class="type-prefixes eq-data eq-cards">
		<div class="eq-card eq-card-accent">
			<div class="eq-card-body eq-prefix-tables">
				{
					tables.map((table) => (
						<section aria-labelledby={`${table.id}-heading`}>
							<h2 id={`${table.id}-heading`} class="sr-only">
								{table.title}
							</h2>
							<div class="eq-table-wrap">
								<table class="eq-table-data">
									<thead>
										<tr>
											<th scope="col">{t(locale, 'table.name')}</th>
											<th scope="col">
												<AbbrLabel
													abbr={t(locale, 'design.legacy.abbr.symbol')}
													full={t(locale, 'table.symbol')}
												/>
											</th>
											<th scope="col">{t(locale, 'design.content.prefixes.exponent')}</th>
											<th scope="col">{t(locale, 'design.content.prefixes.number')}</th>
										</tr>
									</thead>
									<tbody>
										{table.rows.map((prefix) => (
											<tr id={prefix.slug}>
												<td>{localizedName(prefix, locale)}</td>
												<td
													set:html={renderSymbolHtml(
														prefix.symbol.tex,
														prefix.symbol.text ?? prefix.symbol.tex,
													)}
												/>
												<td>
													<MathValue value={prefix.value} format="tex" />
												</td>
												<td class="eq-math-mantissa" set:html={renderSymbolHtml(prefix.number, prefix.number)} />
											</tr>
										))}
									</tbody>
								</table>
							</div>
						</section>
					))
				}
			</div>
		</div>
	</div>
</BaseLayout>
