---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { collectionLabel, type Locale, localizedName, pickLocalized, t } from '@equreka/core/i18n';
import UntranslatedBadge from '../components/untranslated-badge.astro';
import FavoriteToggle from '../islands/favorite-toggle';
import BaseLayout from '../layouts/base-layout.astro';
import { CATEGORY_BADGE, CATEGORY_BORDER, CATEGORY_TEXT } from '../lib/category-styles';
import { asBranch, asCategory } from '../lib/collections';
import { localePath } from '../lib/locale-paths';
import { byCollection, memberEntries } from '../lib/server/taxonomy';

interface Props {
	entry: CollectionEntry<'branches'>;
	locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const branch = asBranch(entry.data);
const slug = entry.id;
const name = localizedName(branch, locale);

const categoryEntry = (await getCollection('categories')).find(
	(item) => item.id === branch.category,
);
const categoryName =
	categoryEntry === undefined
		? branch.category
		: localizedName(asCategory(categoryEntry.data), locale);

const members = (await memberEntries(locale)).filter((member) => member.branches.includes(slug));
const groups = byCollection(members);

const description =
	branch.description === undefined ? undefined : pickLocalized(branch.description, locale);
const untranslated =
	locale !== 'en' &&
	(pickLocalized(branch.name, locale).untranslated || description?.untranslated === true);
const metaDescription =
	description === undefined
		? t(locale, 'meta.branch', { name, category: categoryName })
		: `${description.value.slice(0, 157)}…`;
---

<BaseLayout
	title={`${name} — Equreka`}
	description={metaDescription}
	locale={locale}
	ogType="article"
>
	<article>
		<header
			class={`rounded-lg border border-border ${CATEGORY_BORDER[branch.category] ?? CATEGORY_BORDER.universal} border-t-4 bg-surface p-6`}
		>
			<div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-medium">
				<a
					class={`rounded-full px-2.5 py-0.5 hover:underline ${CATEGORY_BADGE[branch.category] ?? CATEGORY_BADGE.universal}`}
					href={localePath(locale, `/categories/${branch.category}/#branch-${slug}`)}
				>
					{t(locale, 'branch.of', { category: categoryName })}
				</a>
				<UntranslatedBadge locale={locale} show={untranslated} />
			</div>
			<div class="flex flex-wrap items-baseline gap-4">
				<h1
					class={`text-3xl font-bold tracking-tight ${CATEGORY_TEXT[branch.category] ?? 'text-ink'}`}
				>
					{name}
				</h1>
				<FavoriteToggle client:idle collection="branches" slug={slug} locale={locale} />
			</div>
			{description !== undefined && <p class="mt-3 max-w-3xl leading-7">{description.value}</p>}
		</header>

		{
			groups.map((group) => (
				<section aria-labelledby={`${group.collection}-heading`} class="mt-10">
					<h2 id={`${group.collection}-heading`} class="text-2xl font-semibold">
						{collectionLabel(locale, group.collection)}
						<span class="ml-2 text-sm font-normal text-ink-muted">{group.entries.length}</span>
					</h2>
					<ul class="mt-4 grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
						{group.entries.map((member) => (
							<li>
								{member.href !== undefined ? (
									<a class="text-accent hover:underline" href={localePath(locale, member.href)}>
										{member.name}
									</a>
								) : (
									member.name
								)}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</article>
</BaseLayout>
