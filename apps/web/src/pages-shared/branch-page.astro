---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { collectionLabel, type Locale, localizedName, pickLocalized, t } from '@equreka/core/i18n';
import CollapseCard from '../components/collapse-card.astro';
import EntryIdentifiers from '../components/entry-identifiers.astro';
import PageHeader from '../components/page-header.astro';
import UntranslatedBadge from '../components/untranslated-badge.astro';
import FavoriteToggle from '../islands/favorite-toggle';
import BaseLayout from '../layouts/base-layout.astro';
import { asBranch, asCategory } from '../lib/collections';
import { localePath } from '../lib/locale-paths';
import { byCollection, memberEntries } from '../lib/server/taxonomy';

interface Props {
	entry: CollectionEntry<'branches'>;
	locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const branch = asBranch(entry.data);
const slug = entry.id;
const name = localizedName(branch, locale);

const categoryEntry = (await getCollection('categories')).find(
	(item) => item.id === branch.category,
);
const categoryName =
	categoryEntry === undefined
		? branch.category
		: localizedName(asCategory(categoryEntry.data), locale);

const members = (await memberEntries(locale)).filter((member) => member.branches.includes(slug));
const groups = byCollection(members);

/**
 * "View all" targets per member collection; variables have no list page,
 * so their card carries no pill.
 */
const COLLECTION_INDEX: Record<string, string> = {
	magnitudes: '/magnitudes/',
	units: '/units/',
	prefixes: '/prefixes/',
	constants: '/constants/',
	equations: '/equations/',
	paths: '/paths/',
};

const description =
	branch.description === undefined ? undefined : pickLocalized(branch.description, locale);
const untranslated =
	locale !== 'en' &&
	(pickLocalized(branch.name, locale).untranslated || description?.untranslated === true);
const metaDescription =
	description === undefined
		? t(locale, 'meta.branch', { name, category: categoryName })
		: `${description.value.slice(0, 157)}…`;
---

<BaseLayout
	title={`${name} — Equreka`}
	description={metaDescription}
	locale={locale}
	ogType="article"
>
	<PageHeader
		slot="hero"
		label={t(locale, 'branch.of', { category: categoryName })}
		labelHref={localePath(locale, `/categories/${branch.category}/#branch-${slug}`)}
		title={name}
		accent={`cat-${branch.category}`}
	>
		<FavoriteToggle slot="actions" client:idle collection="branches" slug={slug} locale={locale} />
	</PageHeader>
	<article class={`cat-${branch.category} eq-stack`}>
		{
			(untranslated || description !== undefined || branch.externalIds !== undefined) && (
				<CollapseCard
					headingId="branch-information-heading"
					title={t(locale, 'design.content.entry.information')}
				>
					{untranslated && (
						<div class="eq-chip-row">
							<UntranslatedBadge locale={locale} show={untranslated} />
						</div>
					)}
					{description !== undefined && <p class="eq-prose">{description.value}</p>}
					<EntryIdentifiers locale={locale} externalIds={branch.externalIds} />
				</CollapseCard>
			)
		}

		{
			groups.map((group) => {
				const index = COLLECTION_INDEX[group.collection];
				return (
					<CollapseCard
						headingId={`${group.collection}-heading`}
						title={collectionLabel(locale, group.collection)}
						count={group.entries.length}
						chevron="start"
						class="eq-card-accent"
						viewAll={
							index === undefined
								? undefined
								: { href: localePath(locale, index), label: t(locale, 'design.content.viewAll') }
						}
					>
						<ul class="eq-list">
							{group.entries.map((member) => (
								<li>
									{member.href !== undefined ? (
										<a class="eq-list-link" href={localePath(locale, member.href)}>
											{member.name}
										</a>
									) : (
										<span class="eq-list-link">{member.name}</span>
									)}
								</li>
							))}
						</ul>
					</CollapseCard>
				);
			})
		}
	</article>
</BaseLayout>
