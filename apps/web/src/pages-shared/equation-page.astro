---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import equationsPresentation from '@equreka/content/artifact/presentation/equations.json';
import type { LocalizedSegments } from '@equreka/content/rich-text';
import {
	type Locale,
	type LocalizedText,
	localizedName,
	pickLocalized,
	t,
} from '@equreka/core/i18n';
import BranchBadges from '../components/branch-badges.astro';
import DraftBadge from '../components/draft-badge.astro';
import EntryIdentifiers from '../components/entry-identifiers.astro';
import UntranslatedBadge from '../components/untranslated-badge.astro';
import FavoriteToggle from '../islands/favorite-toggle';
import PathContextBar from '../islands/path-context-bar';
import BaseLayout from '../layouts/base-layout.astro';
import { CATEGORY_BADGE } from '../lib/category-styles';
import { asEquation } from '../lib/collections';
import { entryHref } from '../lib/entry-links';
import { localePath } from '../lib/locale-paths';
import { engineSlice } from '../lib/server/engine-registry';
import {
	renderExpressionHtml,
	renderSegmentsHtml,
	renderSymbolHtml,
	termDataValue,
} from '../lib/tex';

interface Props {
	entry: CollectionEntry<'equations'>;
	locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const equation = asEquation(entry.data);
const slug = entry.id;
const name = localizedName(equation, locale);

const TERM_COLLECTIONS = {
	magnitude: 'magnitudes',
	constant: 'constants',
	variable: 'variables',
} as const;

const namesByCollection: Record<string, Map<string, string>> = {};
for (const collection of Object.values(TERM_COLLECTIONS)) {
	const entries = await getCollection(collection);
	namesByCollection[collection] = new Map(
		entries.map((item) => [item.id, localizedName(item.data as { name: LocalizedText }, locale)]),
	);
}

const termRows = Object.entries(equation.terms).map(([key, term]) => {
	const base = {
		key,
		term,
		dataValue: termDataValue(key, term),
		kindLabel: t(locale, `term.${term.kind}`),
	};
	if (term.kind === 'symbol') {
		return { ...base, name: pickLocalized(term.label, locale).value, href: undefined };
	}
	const collection = TERM_COLLECTIONS[term.kind];
	return {
		...base,
		name: namesByCollection[collection]?.get(term.ref) ?? term.ref,
		href: entryHref(collection, term.ref),
	};
});

/**
 * Pipeline-emitted equation slice: related units are derived from the
 * terms (never authored — the hand-maintained list drifted) and the
 * description comes pre-split with `raw` math for term cross-highlighting.
 */
interface EquationPresentation {
	relatedUnits: string[];
	descriptionSegments?: LocalizedSegments;
}

const presentation = (equationsPresentation as Record<string, EquationPresentation>)[slug];
const relatedUnits = (presentation?.relatedUnits ?? [])
	.map((unitSlug) => engineSlice.units[unitSlug])
	.filter((unit) => unit !== undefined);

const description =
	equation.description === undefined ? undefined : pickLocalized(equation.description, locale);
const descriptionSegments =
	description === undefined
		? undefined
		: presentation?.descriptionSegments?.[description.untranslated ? 'en' : locale];
if (description !== undefined && descriptionSegments === undefined) {
	throw new Error(`equations/${slug}: presentation slice has no ${locale} descriptionSegments`);
}
const untranslated =
	locale !== 'en' &&
	(pickLocalized(equation.name, locale).untranslated || description?.untranslated === true);
const metaDescription =
	description === undefined
		? t(locale, 'meta.equation', { name, kind: t(locale, `kind.${equation.kind}`).toLowerCase() })
		: `${description.value.replaceAll('$', '').slice(0, 157)}…`;
---

<BaseLayout
	definedTerm={{ name, externalIds: equation.externalIds }}
	title={`${name} — Equreka`}
	description={metaDescription}
	locale={locale}
	ogType="article"
>
	<article>
		<PathContextBar client:idle locale={locale} />
		<header class="border-b border-border pb-6">
			<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
				<span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-accent">
					{t(locale, `kind.${equation.kind}`)}
				</span>
				{
					equation.categories.map((category) => (
						<span
							class={`rounded-full px-2.5 py-0.5 ${CATEGORY_BADGE[category] ?? CATEGORY_BADGE.universal}`}
						>
							{category}
						</span>
					))
				}
				<BranchBadges locale={locale} branches={equation.branches} />
				<UntranslatedBadge locale={locale} show={untranslated} />
				<DraftBadge locale={locale} status={equation.status} />
			</div>
			<div class="mt-3 flex flex-wrap items-baseline gap-4">
				<h1 class="text-3xl font-bold tracking-tight">{name}</h1>
				<FavoriteToggle client:idle collection="equations" slug={slug} locale={locale} />
			</div>
			<EntryIdentifiers locale={locale} externalIds={equation.externalIds} />
		</header>

		<div class="mt-6 text-xl" set:html={renderExpressionHtml(equation.expression, equation.terms)} />
		<p class="text-sm text-ink-muted">{t(locale, 'equation.hoverHint')}</p>

		{
			equation.calculator.enabled && (
				<a
					class="mt-4 inline-block rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-ink hover:opacity-90"
					href={localePath(locale, `/calculator/${slug}/`)}
				>
					{t(locale, 'equation.solve')}
				</a>
			)
		}

		<section aria-labelledby="equation-terms-heading" class="mt-10">
			<h2 id="equation-terms-heading" class="text-2xl font-semibold">
				{t(locale, 'equation.terms')}
			</h2>
			<div class="mt-4 overflow-x-auto rounded-lg border border-border">
				<table class="w-full border-collapse bg-surface text-left">
					<thead>
						<tr class="border-b border-border text-sm text-ink-muted">
							<th scope="col" class="w-24 px-4 py-2 font-medium">{t(locale, 'table.symbol')}</th>
							<th scope="col" class="px-4 py-2 font-medium">{t(locale, 'table.kind')}</th>
							<th scope="col" class="px-4 py-2 font-medium">{t(locale, 'table.name')}</th>
						</tr>
					</thead>
					<tbody>
						{
							termRows.map((row) => (
								<tr
									data-term={row.dataValue}
									class={`eq-term eq-${row.term.kind} border-b border-border last:border-b-0`}
								>
									<td class="px-4 py-2" set:html={renderSymbolHtml(row.key, row.key)} />
									<td class="px-4 py-2 text-sm text-ink-muted">{row.kindLabel}</td>
									<td class="px-4 py-2">
										{row.href !== undefined ? (
											<a class="text-accent hover:underline" href={localePath(locale, row.href)}>
												{row.name}
											</a>
										) : (
											row.name
										)}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		{
			descriptionSegments !== undefined && (
				<div
					class="mt-8 max-w-3xl leading-7"
					set:html={renderSegmentsHtml(descriptionSegments, equation.terms)}
				/>
			)
		}

		{
			relatedUnits.length > 0 && (
				<section aria-labelledby="equation-units-heading" class="mt-10">
					<h2 id="equation-units-heading" class="text-2xl font-semibold">
						{t(locale, 'equation.relatedUnits')}
					</h2>
					<ul class="mt-3 flex flex-wrap gap-3">
						{relatedUnits.map((unit) => (
							<li>
								<a
									class="text-accent hover:underline"
									href={localePath(locale, `/units/${unit.slug}/`)}
								>
									{localizedName(unit, locale)} ({unit.symbolText})
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>
</BaseLayout>
