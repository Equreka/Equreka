---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { type Locale, localizedName, pickLocalized, t } from '@equreka/core/i18n';
import UnitConversionTable from '../components/unit-conversion-table.astro';
import UntranslatedBadge from '../components/untranslated-badge.astro';
import ConverterIsland from '../islands/converter-island';
import FavoriteToggle from '../islands/favorite-toggle';
import BaseLayout from '../layouts/base-layout.astro';
import { CATEGORY_BADGE } from '../lib/category-styles';
import { asMagnitude, asUnit } from '../lib/collections';
import { localePath } from '../lib/locale-paths';
import { renderRichTextHtml, renderSymbolHtml } from '../lib/tex';
import { symbolTextOf } from '../lib/unit-symbol';

interface Props {
	entry: CollectionEntry<'units'>;
	locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const unit = asUnit(entry.data);
const slug = entry.id;
const symbolText = symbolTextOf({ ...unit, slug });
const name = localizedName(unit, locale);

const magnitudeEntries = await getCollection('magnitudes');
const magnitudes = unit.unitOf.map((magnitudeSlug) => {
	const match = magnitudeEntries.find((candidate) => candidate.id === magnitudeSlug);
	return {
		slug: magnitudeSlug,
		name: match === undefined ? magnitudeSlug : localizedName(asMagnitude(match.data), locale),
	};
});

const description =
	unit.description === undefined ? undefined : pickLocalized(unit.description, locale);
const untranslated =
	locale !== 'en' &&
	(pickLocalized(unit.name, locale).untranslated || description?.untranslated === true);
const metaDescription =
	description === undefined
		? t(locale, 'meta.unit', { name, symbol: symbolText })
		: `${description.value.replaceAll('$', '').slice(0, 157)}…`;
---

<BaseLayout
	title={`${name} (${symbolText}) — Equreka`}
	description={metaDescription}
	locale={locale}
	ogType="article"
>
	<article>
		<header class="border-b border-border pb-6">
			<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
				<span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-accent">
					{t(locale, `system.${unit.system}`)}
				</span>
				{
					unit.categories.map((category) => (
						<span
							class={`rounded-full px-2.5 py-0.5 ${CATEGORY_BADGE[category] ?? CATEGORY_BADGE.universal}`}
						>
							{category}
						</span>
					))
				}
				<UntranslatedBadge locale={locale} show={untranslated} />
			</div>
			<div class="mt-3 flex flex-wrap items-baseline gap-4">
				<h1 class="text-3xl font-bold tracking-tight">{name}</h1>
				<span class="text-2xl" set:html={renderSymbolHtml(unit.symbol.tex, symbolText)} />
				<FavoriteToggle client:idle collection="units" slug={slug} locale={locale} />
			</div>
		</header>

		{
			description !== undefined && (
				<div class="mt-6 max-w-3xl leading-7" set:html={renderRichTextHtml(description.value)} />
			)
		}

		<dl class="mt-6 grid max-w-3xl gap-x-8 gap-y-3 sm:grid-cols-[10rem_1fr]">
			<dt class="text-sm font-medium text-ink-muted">{t(locale, 'table.system')}</dt>
			<dd>{t(locale, `system.${unit.system}`)}</dd>
			<dt class="text-sm font-medium text-ink-muted">
				{magnitudes.length === 1 ? t(locale, 'unit.magnitude') : t(locale, 'unit.magnitudes')}
			</dt>
			<dd class="flex flex-wrap gap-3">
				{
					magnitudes.map((magnitude) => (
						<a
							class="text-accent hover:underline"
							href={localePath(locale, `/converter/?magnitude=${magnitude.slug}`)}
						>
							{magnitude.name}
						</a>
					))
				}
			</dd>
		</dl>

		<UnitConversionTable unitSlug={slug} locale={locale} />

		<section aria-labelledby="unit-converter-heading" class="mt-10">
			<h2 id="unit-converter-heading" class="text-2xl font-semibold">
				{t(locale, 'unit.convert', { name: name.toLowerCase() })}
			</h2>
			<div class="mt-4">
				<ConverterIsland
					client:visible
					initialMagnitude={unit.unitOf[0]}
					initialFrom={slug}
					locale={locale}
				/>
			</div>
		</section>
	</article>
</BaseLayout>
