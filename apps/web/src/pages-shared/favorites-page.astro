---
import { type Locale, t } from '@equreka/core/i18n';
import FavoritesList from '../islands/favorites-list';
import BaseLayout from '../layouts/base-layout.astro';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<BaseLayout
	title={`${t(locale, 'favorites.title')} — Equreka`}
	description={t(locale, 'meta.favorites')}
	locale={locale}
>
	<div class="eq-fav-page">
		<header class="eq-tool-header">
			<h1>{t(locale, 'favorites.title')}</h1>
			<p class="eq-lead">{t(locale, 'favorites.lead')}</p>
		</header>
		<FavoritesList client:load locale={locale} />
	</div>
</BaseLayout>
