---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import pathsPresentation from '@equreka/content/artifact/presentation/paths.json';
import {
	type Locale,
	type LocalizedText,
	localizedName,
	pickLocalized,
	t,
} from '@equreka/core/i18n';
import type { Path } from '@equreka/schema';
import BranchBadges from '../components/branch-badges.astro';
import DraftBadge from '../components/draft-badge.astro';
import UntranslatedBadge from '../components/untranslated-badge.astro';
import FavoriteToggle from '../islands/favorite-toggle';
import PathProgress from '../islands/path-progress';
import PathStepToggle from '../islands/path-step-toggle';
import BaseLayout from '../layouts/base-layout.astro';
import { CATEGORY_BADGE } from '../lib/category-styles';
import { asPath } from '../lib/collections';
import { entryHref, withPathContext } from '../lib/entry-links';
import { localePath } from '../lib/locale-paths';
import { LEVEL_BADGE } from '../lib/path-styles';
import { renderRichTextHtml } from '../lib/tex';

interface Props {
	entry: CollectionEntry<'paths'>;
	locale?: Locale;
}

/**
 * Pipeline-emitted step shape: entry steps carry their resolved target so
 * this page needs no lookup into the target collection.
 */
type PresentationStep = Path['steps'][number] & {
	target?: { name: LocalizedText; symbolText: string };
};

const { entry, locale = 'en' } = Astro.props;
const path = asPath(entry.data);
const slug = entry.id;
const name = localizedName(path, locale);
const steps =
	(pathsPresentation as Record<string, { steps: PresentationStep[] }>)[slug]?.steps ?? path.steps;
const stepIds = steps.map((step) => step.id);

const allPaths = await getCollection('paths');
const prerequisites = path.prerequisites.map((prerequisite) => {
	const match = allPaths.find((candidate) => candidate.id === prerequisite);
	return {
		slug: prerequisite,
		name: match === undefined ? prerequisite : localizedName(asPath(match.data), locale),
	};
});

const description =
	path.description === undefined ? undefined : pickLocalized(path.description, locale);
const stepProse = (step: PresentationStep): LocalizedText[] => {
	switch (step.kind) {
		case 'entry':
			return step.note === undefined ? [] : [step.note];
		case 'prose':
			return [step.body];
		case 'check':
			return [step.prompt, step.answer];
	}
};
const untranslated =
	locale !== 'en' &&
	(pickLocalized(path.name, locale).untranslated ||
		description?.untranslated === true ||
		steps.some((step) => stepProse(step).some((text) => pickLocalized(text, locale).untranslated)));
const levelLabel = t(locale, `path.level.${path.level}`);
const metaDescription =
	description === undefined
		? t(locale, 'meta.path', { name, level: levelLabel.toLowerCase(), count: steps.length })
		: `${description.value.replaceAll('$', '').slice(0, 157)}…`;

const local = (text: LocalizedText): string => pickLocalized(text, locale).value;
---

<BaseLayout title={`${name} — Equreka`} description={metaDescription} locale={locale} ogType="article">
	<article>
		<header class="border-b border-border pb-6">
			<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
				<span class={`rounded-full px-2.5 py-0.5 ${LEVEL_BADGE[path.level] ?? LEVEL_BADGE.intro}`}>
					{levelLabel}
				</span>
				{
					path.categories.map((category) => (
						<span
							class={`rounded-full px-2.5 py-0.5 ${CATEGORY_BADGE[category] ?? CATEGORY_BADGE.universal}`}
						>
							{category}
						</span>
					))
				}
				<BranchBadges locale={locale} branches={path.branches} />
				<UntranslatedBadge locale={locale} show={untranslated} />
				<DraftBadge locale={locale} status={path.status} />
			</div>
			<div class="mt-3 flex flex-wrap items-baseline gap-4">
				<h1 class="text-3xl font-bold tracking-tight">{name}</h1>
				<FavoriteToggle client:idle collection="paths" slug={slug} locale={locale} />
			</div>
			{
				description !== undefined && (
					<p class="mt-3 max-w-3xl text-lg text-ink-muted">{description.value}</p>
				)
			}
			<p class="mt-3 text-sm text-ink-muted">
				{t(locale, 'path.steps', { count: steps.length })}
				{
					path.estimatedMinutes !== undefined &&
						` · ${t(locale, 'path.minutes', { count: path.estimatedMinutes })}`
				}
			</p>
			{
				prerequisites.length > 0 && (
					<p class="mt-2 text-sm">
						<span class="text-ink-muted">{t(locale, 'path.prerequisites')}: </span>
						{prerequisites.map((prerequisite, index) => (
							<>
								{index > 0 && ', '}
								<a
									class="text-accent hover:underline"
									href={localePath(locale, `/paths/${prerequisite.slug}/`)}
								>
									{prerequisite.name}
								</a>
							</>
						))}
					</p>
				)
			}
			<PathProgress client:idle variant="bar" pathSlug={slug} stepIds={stepIds} locale={locale} />
		</header>

		<ol class="mt-8 grid gap-5">
			{
				steps.map((step, index) => {
					const kindLabel = `${index + 1} · ${t(locale, `path.kind.${step.kind}`)}`;
					const href =
						step.kind === 'entry' ? entryHref(step.ref.collection, step.ref.slug) : undefined;
					const linked = href === undefined ? undefined : localePath(locale, withPathContext(href, slug, step.id));
					const targetName =
						step.kind === 'entry' ? (step.target === undefined ? step.ref.slug : local(step.target.name)) : '';
					const targetSymbol = step.kind === 'entry' ? (step.target?.symbolText ?? '') : '';
					return (
						<li id={`step-${step.id}`} class="scroll-mt-6 rounded-lg border border-border bg-surface p-5">
							<div class="flex items-start gap-4">
								<PathStepToggle
									client:idle
									pathSlug={slug}
									stepId={step.id}
									stepIds={stepIds}
									locale={locale}
								/>
								<div class="min-w-0 flex-1">
									<p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">{kindLabel}</p>
									{step.kind === 'entry' && (
										<>
											<h2 class="mt-1 flex flex-wrap items-baseline gap-3 text-xl font-semibold">
												{linked !== undefined ? (
													<a class="text-accent hover:underline" href={linked}>
														{targetName}
													</a>
												) : (
													<span>{targetName}</span>
												)}
												{targetSymbol !== '' && (
													<span class="font-mono text-base text-ink-muted">{targetSymbol}</span>
												)}
											</h2>
											{step.note !== undefined && (
												<div class="mt-2 max-w-3xl leading-7" set:html={renderRichTextHtml(local(step.note))} />
											)}
											{linked !== undefined && (
												<a class="mt-2 inline-block text-sm text-accent hover:underline" href={linked}>
													{t(locale, 'path.openEntry')} →
												</a>
											)}
										</>
									)}
									{step.kind === 'prose' && (
										<div class="mt-2 max-w-3xl leading-7" set:html={renderRichTextHtml(local(step.body))} />
									)}
									{step.kind === 'check' && (
										<details class="mt-1 max-w-3xl">
											<summary class="cursor-pointer leading-7">
												<span class="font-medium" set:html={renderRichTextHtml(local(step.prompt))} />
												<span class="ml-2 text-sm text-accent">{t(locale, 'path.reveal')}</span>
											</summary>
											<div
												class="mt-3 border-l-2 border-accent/40 pl-4 leading-7"
												set:html={renderRichTextHtml(local(step.answer))}
											/>
										</details>
									)}
								</div>
							</div>
						</li>
					);
				})
			}
		</ol>
	</article>
</BaseLayout>
