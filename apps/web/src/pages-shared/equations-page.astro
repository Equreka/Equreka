---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';
import { CATEGORY_BADGE } from '../lib/category-styles';
import { asEquation } from '../lib/collections';
import { EQUATION_KIND_LABELS } from '../lib/labels';
import { renderExpressionHtml } from '../lib/tex';

const equations = (await getCollection('equations'))
	.map((entry) => ({ slug: entry.id, ...asEquation(entry.data) }))
	.sort((a, b) => a.name.en.localeCompare(b.name.en));
---

<BaseLayout
	title="Equations — Equreka"
	description="Equations and formulas in the Equreka wiki, with term-by-term breakdowns and calculators."
>
	<h1 class="text-3xl font-bold tracking-tight">Equations</h1>
	<p class="mt-2 max-w-2xl text-ink-muted">
		{equations.length} equations and formulas. Hover a term to highlight it everywhere on the page;
		calculator-enabled entries solve for any term.
	</p>
	<ul class="mt-6 grid gap-4">
		{
			equations.map((equation) => (
				<li class="rounded-lg border border-border bg-surface p-5">
					<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
						<span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-accent">
							{EQUATION_KIND_LABELS[equation.kind]}
						</span>
						{equation.categories.map((category) => (
							<span
								class={`rounded-full px-2.5 py-0.5 ${CATEGORY_BADGE[category] ?? CATEGORY_BADGE.universal}`}
							>
								{category}
							</span>
						))}
					</div>
					<h2 class="mt-2 text-xl font-semibold">
						<a class="text-accent hover:underline" href={`/equations/${equation.slug}/`}>
							{equation.name.en}
						</a>
					</h2>
					<div
						class="mt-2"
						set:html={renderExpressionHtml(equation.expression, equation.terms)}
					/>
					{equation.calculator.enabled && (
						<a
							class="mt-2 inline-block text-sm text-accent hover:underline"
							href={`/calculator/${equation.slug}/`}
						>
							Open in the calculator →
						</a>
					)}
				</li>
			))
		}
	</ul>
</BaseLayout>
