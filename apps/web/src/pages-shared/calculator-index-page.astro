---
import { getCollection } from 'astro:content';
import { type Locale, localizedName, t } from '@equreka/core/i18n';
import BaseLayout from '../layouts/base-layout.astro';
import { asEquation } from '../lib/collections';
import { localePath } from '../lib/locale-paths';
import { renderExpressionHtml } from '../lib/tex';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const equations = (await getCollection('equations'))
	.map((entry) => ({ slug: entry.id, ...asEquation(entry.data) }))
	.filter((equation) => equation.calculator.enabled)
	.sort((a, b) => localizedName(a, locale).localeCompare(localizedName(b, locale), locale));
---

<BaseLayout
	title={`${t(locale, 'calculator.title')} — Equreka`}
	description={t(locale, 'meta.calculator')}
	locale={locale}
>
	<header class="eq-tool-header">
		<h1>{t(locale, 'calculator.title')}</h1>
		<p class="eq-lead">{t(locale, 'calculator.lead', { count: equations.length })}</p>
	</header>
	<ul class="eq-calc-index">
		{
			equations.map((equation) => (
				<li
					class:list={[
						'eq-card eq-card-accent',
						equation.kind === 'formula' ? 'type-formulas' : 'type-equations',
					]}
				>
					<div class="eq-card-body">
						<span class="eq-badge eq-badge-accent">{t(locale, `kind.${equation.kind}`)}</span>
						<h2 class="eq-card-title">
							<a class="eq-link" href={localePath(locale, `/calculator/${equation.slug}/`)}>
								{localizedName(equation, locale)}
							</a>
						</h2>
						<div
							class="eq-calc-index-expr eq-scrollbar-thin"
							set:html={renderExpressionHtml(equation.expression, equation.terms)}
						/>
					</div>
				</li>
			))
		}
	</ul>
</BaseLayout>
