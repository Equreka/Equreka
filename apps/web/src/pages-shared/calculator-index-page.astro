---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';
import { asEquation } from '../lib/collections';
import { EQUATION_KIND_LABELS } from '../lib/labels';
import { renderExpressionHtml } from '../lib/tex';

const equations = (await getCollection('equations'))
	.map((entry) => ({ slug: entry.id, ...asEquation(entry.data) }))
	.filter((equation) => equation.calculator.enabled)
	.sort((a, b) => a.name.en.localeCompare(b.name.en));
---

<BaseLayout
	title="Calculator — Equreka"
	description="Solve any calculator-enabled equation for any term with the Equreka engine."
>
	<h1 class="text-3xl font-bold tracking-tight">Calculator</h1>
	<p class="mt-2 max-w-2xl text-ink-muted">
		{equations.length} equations can be solved for any of their terms: fill in every value except
		one, and the engine computes the rest — no unit conversions to get wrong.
	</p>
	<ul class="mt-6 grid gap-4">
		{
			equations.map((equation) => (
				<li class="rounded-lg border border-border bg-surface p-5">
					<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
						<span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-accent">
							{EQUATION_KIND_LABELS[equation.kind]}
						</span>
					</div>
					<h2 class="mt-2 text-xl font-semibold">
						<a class="text-accent hover:underline" href={`/calculator/${equation.slug}/`}>
							{equation.name.en}
						</a>
					</h2>
					<div
						class="mt-2"
						set:html={renderExpressionHtml(equation.expression, equation.terms)}
					/>
				</li>
			))
		}
	</ul>
</BaseLayout>
