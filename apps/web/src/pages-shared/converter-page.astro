---
import ConverterIsland from '../islands/converter-island';
import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout
	title="Unit converter — Equreka"
	description="Convert values between compatible units of measurement, computed by the Equreka engine."
>
	<h1 class="text-3xl font-bold tracking-tight">Unit converter</h1>
	<p class="mt-2 max-w-2xl text-ink-muted">
		Pick a magnitude, choose the units, and enter a value. Conversions run through each unit's
		exact factor to the SI-coherent base — results are rounded to 6 significant figures for
		display.
	</p>
	<div class="mt-6 max-w-2xl">
		<ConverterIsland client:load />
	</div>
</BaseLayout>
