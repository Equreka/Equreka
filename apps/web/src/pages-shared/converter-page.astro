---
import { type Locale, t } from '@equreka/core/i18n';
import ConverterIsland from '../islands/converter-island';
import BaseLayout from '../layouts/base-layout.astro';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<BaseLayout
	title={`${t(locale, 'converter.title')} — Equreka`}
	description={t(locale, 'meta.converter')}
	locale={locale}
>
	<h1 class="text-3xl font-bold tracking-tight">{t(locale, 'converter.title')}</h1>
	<p class="mt-2 max-w-2xl text-ink-muted">{t(locale, 'converter.lead')}</p>
	<div class="mt-6 max-w-2xl">
		<ConverterIsland client:load locale={locale} />
	</div>
</BaseLayout>
