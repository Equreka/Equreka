---
import type { CollectionEntry } from 'astro:content';
import { collectionLabel, type Locale, localizedName, pickLocalized, t } from '@equreka/core/i18n';
import { branchesOfCategory, groupByBranch } from '@equreka/core/taxonomy';
import EntryIdentifiers from '../components/entry-identifiers.astro';
import UntranslatedBadge from '../components/untranslated-badge.astro';
import FavoriteToggle from '../islands/favorite-toggle';
import BaseLayout from '../layouts/base-layout.astro';
import { CATEGORY_BORDER, CATEGORY_TEXT } from '../lib/category-styles';
import { asCategory } from '../lib/collections';
import { localePath } from '../lib/locale-paths';
import { branchRecords, byCollection, memberEntries } from '../lib/server/taxonomy';

interface Props {
	entry: CollectionEntry<'categories'>;
	locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const category = asCategory(entry.data);
const slug = entry.id;
const name = localizedName(category, locale);

const branches = await branchRecords();
const members = (await memberEntries(locale)).filter((member) => member.categories.includes(slug));
const branchGroups = groupByBranch(members, branchesOfCategory(branches, slug)).map((group) => {
	const branch = group.branch === null ? undefined : branches[group.branch];
	return {
		id: group.branch ?? 'general',
		title: branch === undefined ? t(locale, 'branch.general') : localizedName(branch, locale),
		href: group.branch === null ? undefined : `/branches/${group.branch}/`,
		count: group.entries.length,
		collections: byCollection(group.entries),
	};
});

const description =
	category.description === undefined ? undefined : pickLocalized(category.description, locale);
const untranslated =
	locale !== 'en' &&
	(pickLocalized(category.name, locale).untranslated || description?.untranslated === true);
const metaDescription =
	description === undefined
		? t(locale, 'meta.category', { name })
		: `${description.value.slice(0, 157)}…`;
---

<BaseLayout
	title={`${name} — Equreka`}
	description={metaDescription}
	locale={locale}
	ogType="article"
>
	<article>
		<header
			class={`rounded-lg border border-border ${CATEGORY_BORDER[slug] ?? CATEGORY_BORDER.universal} border-t-4 bg-surface p-6`}
		>
			{
				untranslated && (
					<div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-medium">
						<UntranslatedBadge locale={locale} show={untranslated} />
					</div>
				)
			}
			<div class="flex flex-wrap items-baseline gap-4">
				<h1 class={`text-3xl font-bold tracking-tight ${CATEGORY_TEXT[slug] ?? 'text-ink'}`}>
					{name}
				</h1>
				<FavoriteToggle client:idle collection="categories" slug={slug} locale={locale} />
			</div>
			{description !== undefined && <p class="mt-3 max-w-3xl leading-7">{description.value}</p>}
			<EntryIdentifiers locale={locale} externalIds={category.externalIds} />
		</header>

		{
			branchGroups.length > 1 && (
				<nav aria-labelledby="branches-nav-heading" class="mt-8">
					<h2 id="branches-nav-heading" class="text-sm font-medium text-ink-muted">
						{t(locale, 'category.branches')}
					</h2>
					<ul class="mt-2 flex flex-wrap gap-2 text-sm">
						{branchGroups.map((group) => (
							<li>
								<a
									class="inline-block rounded-full border border-border bg-surface px-3 py-1 text-accent hover:underline"
									href={`#branch-${group.id}`}
								>
									{group.title}
									<span class="ml-1 text-ink-muted">{group.count}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}

		{
			branchGroups.map((group) => (
				<section aria-labelledby={`branch-${group.id}`} class="mt-10">
					<h2 id={`branch-${group.id}`} class="text-2xl font-semibold">
						{group.href !== undefined ? (
							<a class="hover:underline" href={localePath(locale, group.href)}>
								{group.title}
							</a>
						) : (
							group.title
						)}
						<span class="ml-2 text-sm font-normal text-ink-muted">{group.count}</span>
					</h2>
					{group.collections.map((members) => (
						<>
							<h3
								id={`branch-${group.id}-${members.collection}`}
								class="mt-5 text-lg font-medium text-ink-muted"
							>
								{collectionLabel(locale, members.collection)}
								<span class="ml-2 text-sm font-normal">{members.entries.length}</span>
							</h3>
							<ul class="mt-2 grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
								{members.entries.map((member) => (
									<li>
										{member.href !== undefined ? (
											<a
												class="text-accent hover:underline"
												href={localePath(locale, member.href)}
											>
												{member.name}
											</a>
										) : (
											member.name
										)}
									</li>
								))}
							</ul>
						</>
					))}
				</section>
			))
		}
	</article>
</BaseLayout>
