---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import {
	collectionLabel,
	type Locale,
	type LocalizedText,
	localizedName,
	pickLocalized,
	t,
} from '@equreka/core/i18n';
import UntranslatedBadge from '../components/untranslated-badge.astro';
import FavoriteToggle from '../islands/favorite-toggle';
import BaseLayout from '../layouts/base-layout.astro';
import { CATEGORY_BORDER, CATEGORY_TEXT } from '../lib/category-styles';
import { asCategory } from '../lib/collections';
import { entryHref } from '../lib/entry-links';
import { localePath } from '../lib/locale-paths';

interface Props {
	entry: CollectionEntry<'categories'>;
	locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const category = asCategory(entry.data);
const slug = entry.id;
const name = localizedName(category, locale);

const MEMBER_COLLECTIONS = [
	'magnitudes',
	'units',
	'prefixes',
	'constants',
	'variables',
	'equations',
] as const;

interface MemberEntry {
	name: string;
	href: string | undefined;
}

const groups: { collection: string; label: string; members: MemberEntry[] }[] = [];
for (const collection of MEMBER_COLLECTIONS) {
	const entries = await getCollection(collection);
	const members = entries
		.map((item) => ({
			id: item.id,
			data: item.data as { name: LocalizedText; categories: string[] },
		}))
		.filter((item) => item.data.categories.includes(slug))
		.map((item) => ({
			name: localizedName(item.data, locale),
			href: entryHref(collection, item.id),
		}))
		.sort((a, b) => a.name.localeCompare(b.name, locale));
	if (members.length > 0) {
		groups.push({ collection, label: collectionLabel(locale, collection), members });
	}
}

const description =
	category.description === undefined ? undefined : pickLocalized(category.description, locale);
const untranslated =
	locale !== 'en' &&
	(pickLocalized(category.name, locale).untranslated || description?.untranslated === true);
const metaDescription =
	description === undefined
		? t(locale, 'meta.category', { name })
		: `${description.value.slice(0, 157)}…`;
---

<BaseLayout
	title={`${name} — Equreka`}
	description={metaDescription}
	locale={locale}
	ogType="article"
>
	<article>
		<header
			class={`rounded-lg border border-border ${CATEGORY_BORDER[slug] ?? CATEGORY_BORDER.universal} border-t-4 bg-surface p-6`}
		>
			{
				untranslated && (
					<div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-medium">
						<UntranslatedBadge locale={locale} show={untranslated} />
					</div>
				)
			}
			<div class="flex flex-wrap items-baseline gap-4">
				<h1 class={`text-3xl font-bold tracking-tight ${CATEGORY_TEXT[slug] ?? 'text-ink'}`}>
					{name}
				</h1>
				<FavoriteToggle client:idle collection="categories" slug={slug} locale={locale} />
			</div>
			{description !== undefined && <p class="mt-3 max-w-3xl leading-7">{description.value}</p>}
		</header>

		{
			groups.map((group) => (
				<section aria-labelledby={`${group.collection}-heading`} class="mt-10">
					<h2 id={`${group.collection}-heading`} class="text-2xl font-semibold">
						{group.label}
						<span class="ml-2 text-sm font-normal text-ink-muted">{group.members.length}</span>
					</h2>
					<ul class="mt-4 grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
						{group.members.map((member) => (
							<li>
								{member.href !== undefined ? (
									<a class="text-accent hover:underline" href={localePath(locale, member.href)}>
										{member.name}
									</a>
								) : (
									member.name
								)}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</article>
</BaseLayout>
