---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { collectionLabel, type Locale, localizedName, pickLocalized, t } from '@equreka/core/i18n';
import Icon from '../components/icon.astro';
import CalculatorIsland, {
	type CalculatorConstant,
	type CalculatorField,
} from '../islands/calculator-island';
import BaseLayout from '../layouts/base-layout.astro';
import type { CalculatorVariableUnits } from '../lib/calculator-units';
import { asEquation, asVariable } from '../lib/collections';
import { localePath } from '../lib/locale-paths';
import { engineSlice } from '../lib/server/engine-registry';
import { renderExpressionHtml } from '../lib/tex';

interface Props {
	entry: CollectionEntry<'equations'>;
	locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const equation = asEquation(entry.data);
const slug = entry.id;
const name = localizedName(equation, locale);
const entryPath = localePath(locale, `/equations/${slug}/`);
const accentClass = equation.kind === 'formula' ? 'type-formulas' : 'type-equations';

const meta = engineSlice.equations[slug];
if (meta === undefined || !meta.calculatorEnabled) {
	throw new Error(`calculator page for ${slug} requires a calculator-enabled engine equation`);
}

const variables = new Map(
	(await getCollection('variables')).map((item) => [item.id, asVariable(item.data)]),
);

const fields: CalculatorField[] = [];
const constants: CalculatorConstant[] = [];
const nonNegative: string[] = [];
const variableUnits: CalculatorVariableUnits = {};
for (const [key, term] of Object.entries(meta.terms)) {
	if (term.kind === 'symbol') {
		fields.push({
			key,
			label: term.label === undefined ? key : pickLocalized(term.label, locale).value,
			symbolText: key,
			unitSymbol: term.unit === undefined ? '' : (engineSlice.units[term.unit]?.symbolText ?? ''),
		});
		continue;
	}
	if (term.ref === undefined) {
		throw new Error(`calculator page for ${slug}: ${term.kind} term ${key} has no ref`);
	}
	if (term.kind === 'constant') {
		const constant = engineSlice.constants[term.ref];
		if (constant === undefined) {
			throw new Error(`calculator page for ${slug}: unknown constant ${term.ref}`);
		}
		constants.push({
			key,
			name: localizedName(constant, locale),
			symbolText: constant.symbolText,
			value: constant.value,
			unitSymbol: engineSlice.units[constant.unit]?.symbolText ?? '',
		});
		continue;
	}
	if (term.kind === 'magnitude') {
		const magnitude = engineSlice.magnitudes[term.ref];
		if (magnitude === undefined) {
			throw new Error(`calculator page for ${slug}: unknown magnitude ${term.ref}`);
		}
		fields.push({
			key,
			label: localizedName(magnitude, locale),
			symbolText: key,
			unitSymbol: engineSlice.units[magnitude.baseUnit]?.symbolText ?? '',
		});
		if (magnitude.nonNegative) nonNegative.push(key);
		continue;
	}
	const variable = variables.get(term.ref);
	if (variable?.defaultUnit !== undefined) {
		variableUnits[term.ref] = { defaultUnit: variable.defaultUnit };
	}
	fields.push({
		key,
		label: variable === undefined ? key : localizedName(variable, locale),
		symbolText: key,
		unitSymbol:
			variable?.defaultUnit === undefined
				? ''
				: (engineSlice.units[variable.defaultUnit]?.symbolText ?? ''),
	});
}
---

<BaseLayout
	title={`${t(locale, 'calculator.pageTitle', { name })} — Equreka`}
	description={t(locale, 'meta.calculatorEquation', { name })}
	locale={locale}
>
	<div slot="hero" class:list={['eq-accent-panel eq-page-header', accentClass]}>
		<div class="eq-container eq-hero-row">
			<div>
				<a class="eq-page-header-label eq-hero-label" href={localePath(locale, '/equations/')}>
					{collectionLabel(locale, 'equations')}
				</a>
				<h1 class="eq-page-header-title">{t(locale, 'calculator.pageTitle', { name })}</h1>
			</div>
			<div class="eq-hero-actions">
				<a
					class="eq-hero-action"
					href={entryPath}
					title={t(locale, 'design.interactive.openEquation')}
				>
					<Icon name="info-square" />
					<span class="sr-only">{t(locale, 'design.interactive.openEquation')}</span>
				</a>
			</div>
		</div>
	</div>
	<div class:list={['eq-tool', accentClass]}>
		<div class="eq-card eq-calc-expression">
			<div
				class="eq-display-math"
				set:html={renderExpressionHtml(equation.expression, equation.terms)}
			/>
		</div>
		<p class="eq-calc-lead">
			{t(locale, 'calculator.leadBefore')}{' '}
			<a class="eq-link" href={entryPath}>{t(locale, 'calculator.leadLink')}</a>{' '}
			{t(locale, 'calculator.leadAfter')}
		</p>
		<CalculatorIsland
			client:load
			meta={meta}
			fields={fields}
			constants={constants}
			nonNegative={nonNegative}
			variables={variableUnits}
			locale={locale}
		/>
	</div>
</BaseLayout>
