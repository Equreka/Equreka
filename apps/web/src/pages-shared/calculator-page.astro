---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { collectionLabel, type Locale, localizedName, pickLocalized, t } from '@equreka/core/i18n';
import type { CompiledUnit } from '@equreka/schema';
import EntryActions from '../components/entry-actions.astro';
import IconGlyph from '../components/icon-glyph.astro';
import PageHeader from '../components/page-header.astro';
import CalculatorIsland, { type CalculatorConstant } from '../islands/calculator-island';
import FavoriteToggle from '../islands/favorite-toggle';
import { LegacyAbbr } from '../islands/legacy-abbr';
import BaseLayout from '../layouts/base-layout.astro';
import {
	type CalculatorField,
	calculatorField,
	calculatorUnitSymbol,
	convertibleFieldUnit,
	displayFieldUnit,
} from '../lib/calculator-fields';
import type { CalculatorVariableUnits } from '../lib/calculator-units';
import { asEquation, asVariable } from '../lib/collections';
import { entryHref } from '../lib/entry-links';
import { localePath } from '../lib/locale-paths';
import { engineSlice } from '../lib/server/engine-registry';
import { renderExpressionHtml, renderSymbolHtml, termDataValue } from '../lib/tex';

interface Props {
	entry: CollectionEntry<'equations'>;
	locale?: Locale;
}

/**
 * One row of the legacy Variables / Magnitudes tables under the
 * calculator; the original listed no constants there. `unit` is the unit
 * the field takes: a magnitude's display unit when it has one.
 */
interface TermRow {
	key: string;
	kind: 'magnitude' | 'variable' | 'symbol';
	dataValue: string;
	name: string;
	href: string | undefined;
	unit: Pick<CompiledUnit, 'slug' | 'name' | 'symbolTex' | 'symbolText'> | undefined;
}

const { entry, locale = 'en' } = Astro.props;
const equation = asEquation(entry.data);
const slug = entry.id;
const name = localizedName(equation, locale);
const entryPath = localePath(locale, `/equations/${slug}/`);
const accentClass = equation.kind === 'formula' ? 'type-formulas' : 'type-equations';

const meta = engineSlice.equations[slug];
if (meta === undefined || !meta.calculatorEnabled) {
	throw new Error(`calculator page for ${slug} requires a calculator-enabled engine equation`);
}

const unitOf = (unitSlug: string | undefined): CompiledUnit | undefined =>
	unitSlug === undefined ? undefined : engineSlice.units[unitSlug];

const variables = new Map(
	(await getCollection('variables')).map((item) => [item.id, asVariable(item.data)]),
);

const fields: CalculatorField[] = [];
const constants: CalculatorConstant[] = [];
const nonNegative: string[] = [];
const variableUnits: CalculatorVariableUnits = {};
const variableRows: TermRow[] = [];
const magnitudeRows: TermRow[] = [];
for (const [key, term] of Object.entries(meta.terms)) {
	if (term.kind === 'symbol') {
		const label = term.label === undefined ? key : pickLocalized(term.label, locale).value;
		const unit = unitOf(term.unit);
		fields.push(calculatorField(meta, key, label, convertibleFieldUnit(unit)));
		variableRows.push({
			key,
			kind: 'symbol',
			dataValue: termDataValue(key, { kind: 'symbol', identifier: term.identifier }),
			name: label,
			href: undefined,
			unit,
		});
		continue;
	}
	if (term.ref === undefined) {
		throw new Error(`calculator page for ${slug}: ${term.kind} term ${key} has no ref`);
	}
	const dataValue = termDataValue(key, { kind: term.kind, ref: term.ref });
	if (term.kind === 'constant') {
		const constant = engineSlice.constants[term.ref];
		if (constant === undefined) {
			throw new Error(`calculator page for ${slug}: unknown constant ${term.ref}`);
		}
		const constantUnit = unitOf(constant.unit);
		constants.push({
			key,
			name: localizedName(constant, locale),
			symbolText: constant.symbolText,
			value: constant.value,
			unitSymbol: constantUnit === undefined ? '' : calculatorUnitSymbol(constantUnit),
		});
		continue;
	}
	if (term.kind === 'magnitude') {
		const magnitude = engineSlice.magnitudes[term.ref];
		if (magnitude === undefined) {
			throw new Error(`calculator page for ${slug}: unknown magnitude ${term.ref}`);
		}
		const magnitudeName = localizedName(magnitude, locale);
		const baseUnit = unitOf(magnitude.baseUnit);
		fields.push(
			calculatorField(
				meta,
				key,
				magnitudeName,
				magnitude.displayUnit === undefined
					? convertibleFieldUnit(baseUnit)
					: displayFieldUnit(magnitude.displayUnit),
			),
		);
		if (magnitude.nonNegative) nonNegative.push(key);
		magnitudeRows.push({
			key,
			kind: 'magnitude',
			dataValue,
			name: magnitudeName,
			href: entryHref('magnitudes', term.ref),
			unit: magnitude.displayUnit ?? baseUnit,
		});
		continue;
	}
	const variable = variables.get(term.ref);
	if (variable?.defaultUnit !== undefined) {
		variableUnits[term.ref] = { defaultUnit: variable.defaultUnit };
	}
	const variableName = variable === undefined ? key : localizedName(variable, locale);
	const defaultUnit = unitOf(variable?.defaultUnit);
	fields.push(calculatorField(meta, key, variableName, convertibleFieldUnit(defaultUnit)));
	variableRows.push({
		key,
		kind: 'variable',
		dataValue,
		name: variableName,
		href: entryHref('variables', term.ref),
		unit: defaultUnit,
	});
}

const termTables = [
	{ id: 'calculator-variables-heading', collection: 'variables', rows: variableRows },
	{ id: 'calculator-magnitudes-heading', collection: 'magnitudes', rows: magnitudeRows },
].filter((table) => table.rows.length > 0);

const openEquationLabel = t(locale, 'design.interactive.openEquation');
---

<BaseLayout
	title={`${t(locale, 'calculator.pageTitle', { name })} — Equreka`}
	description={t(locale, 'meta.calculatorEquation', { name })}
	locale={locale}
>
	<PageHeader
		slot="hero"
		entry
		label={collectionLabel(locale, 'equations')}
		labelHref={localePath(locale, '/equations/')}
		title={name}
		accent={accentClass}
	>
		<EntryActions
			slot="actions"
			locale={locale}
			collection="equations"
			slug={slug}
			data={entry.data}
		>
			<a class="eq-page-action" href={entryPath} title={openEquationLabel}>
				<IconGlyph name="info-square" />
				<span class="sr-only">{openEquationLabel}</span>
			</a>
			<FavoriteToggle client:idle collection="equations" slug={slug} locale={locale} />
		</EntryActions>
	</PageHeader>
	<div class:list={['eq-calc-page', 'eq-data', accentClass]}>
		<CalculatorIsland
			client:load
			meta={meta}
			fields={fields}
			constants={constants}
			nonNegative={nonNegative}
			variables={variableUnits}
			locale={locale}
		>
			<div
				class="eq-calc-backdrop-math"
				set:html={renderExpressionHtml(equation.expression, equation.terms)}
			/>
		</CalculatorIsland>
		{
			termTables.length > 0 && (
				<div class="eq-calc-tables">
					{termTables.map((table) => (
						<section class="eq-card eq-card-body eq-calc-table" aria-labelledby={table.id}>
							<h2 id={table.id} class="eq-card-title">
								{collectionLabel(locale, table.collection)}
							</h2>
							<div class="eq-table-wrap">
								<table class="eq-table-data">
									<thead>
										<tr>
											<th scope="col">
												<LegacyAbbr term="symbol" label={t(locale, 'table.symbol')} locale={locale} />
											</th>
											<th scope="col">{t(locale, 'table.name')}</th>
											<th scope="col" colspan="2">
												{t(locale, 'table.unit')}
											</th>
										</tr>
									</thead>
									<tbody>
										{table.rows.map((row) => {
											const { unit } = row;
											return (
												<tr data-term={row.dataValue} class={`eq-term eq-${row.kind}`}>
													<td class="eq-cell-symbol" set:html={renderSymbolHtml(row.key, row.key)} />
													<td>
														{row.href !== undefined ? (
															<a class="eq-link" href={localePath(locale, row.href)}>
																{row.name}
															</a>
														) : (
															row.name
														)}
													</td>
													<td
														class="eq-cell-unit-symbol"
														set:html={
															unit === undefined
																? ''
																: renderSymbolHtml(unit.symbolTex, unit.symbolText)
														}
													/>
													<td>
														{unit !== undefined && (
															<a class="eq-link" href={localePath(locale, `/units/${unit.slug}/`)}>
																{localizedName(unit, locale)}
															</a>
														)}
													</td>
												</tr>
											);
										})}
									</tbody>
								</table>
							</div>
						</section>
					))}
				</div>
			)
		}
	</div>
</BaseLayout>
