---
import { getCollection } from 'astro:content';
import { type Locale, localizedName, type MessageKey, pickLocalized, t } from '@equreka/core/i18n';
import SearchBox from '../islands/search-box';
import BaseLayout from '../layouts/base-layout.astro';
import { asCategory } from '../lib/collections';
import { localePath } from '../lib/locale-paths';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;

/**
 * The original's category cards printed UI-catalog leads, not the content
 * description, so the four legacy categories keep that wording; any other
 * category falls back to its content description.
 */
const LEGACY_CATEGORY_LEADS: Readonly<Record<string, MessageKey>> = {
	universal: 'design.content.home.category.universal',
	mathematics: 'design.content.home.category.mathematics',
	physics: 'design.content.home.category.physics',
	chemistry: 'design.content.home.category.chemistry',
};

const categories = (await getCollection('categories'))
	.map((entry) => {
		const category = asCategory(entry.data);
		const leadKey = LEGACY_CATEGORY_LEADS[entry.id];
		return {
			slug: entry.id,
			order: category.order,
			name: localizedName(category, locale),
			lead:
				leadKey !== undefined
					? t(locale, leadKey)
					: category.description === undefined
						? undefined
						: pickLocalized(category.description, locale).value,
		};
	})
	.sort((a, b) => a.order - b.order);

/**
 * The original's types view: its type order and encyclopedic leads.
 * Formulas share the equations collection and variables have no list page
 * in this app (they live as equation terms), so both cards open the
 * equations list. The v2-only destinations follow the original types.
 */
const collectionCards = [
	{
		title: t(locale, 'collection.equations'),
		description: t(locale, 'design.content.home.type.equations'),
		href: '/equations/',
		accent: 'type-equations',
	},
	{
		title: t(locale, 'design.content.home.formulas'),
		description: t(locale, 'design.content.home.type.formulas'),
		href: '/equations/',
		accent: 'type-formulas',
	},
	{
		title: t(locale, 'collection.constants'),
		description: t(locale, 'design.content.home.type.constants'),
		href: '/constants/',
		accent: 'type-constants',
	},
	{
		title: t(locale, 'collection.magnitudes'),
		description: t(locale, 'design.content.home.type.magnitudes'),
		href: '/magnitudes/',
		accent: 'type-magnitudes',
	},
	{
		title: t(locale, 'collection.variables'),
		description: t(locale, 'design.content.home.type.variables'),
		href: '/equations/',
		accent: 'type-variables',
	},
	{
		title: t(locale, 'collection.units'),
		description: t(locale, 'design.content.home.type.units'),
		href: '/units/',
		accent: 'type-units',
	},
	{
		title: t(locale, 'collection.prefixes'),
		description: t(locale, 'design.content.home.type.prefixes'),
		href: '/prefixes/',
		accent: 'type-prefixes',
	},
	{
		title: t(locale, 'paths.title'),
		description: t(locale, 'home.card.paths'),
		href: '/paths/',
		accent: 'type-paths',
	},
	{
		title: t(locale, 'nav.calculator'),
		description: t(locale, 'home.card.calculator'),
		href: '/calculator/',
		accent: 'sw-green',
	},
	{
		title: t(locale, 'nav.converter'),
		description: t(locale, 'home.card.converter'),
		href: '/converter/',
		accent: 'type-units',
	},
	{
		title: t(locale, 'nav.search'),
		description: t(locale, 'home.card.search'),
		href: '/search/',
		accent: 'sw-indigo',
	},
];
---

<BaseLayout title={t(locale, 'home.title')} description={t(locale, 'meta.home')} locale={locale}>
	<h1 class="sr-only">Equreka</h1>
	<p class="sr-only">{t(locale, 'home.lead')}</p>
	<div class="eq-home-search">
		<SearchBox client:idle variant="header" locale={locale} />
	</div>

	<input
		type="radio"
		name="home-view"
		id="home-view-categories"
		class="sr-only"
		aria-controls="home-panel-categories"
		checked
	/>
	<input
		type="radio"
		name="home-view"
		id="home-view-types"
		class="sr-only"
		aria-controls="home-panel-types"
	/>
	<div class="eq-home-toggle">
		<label for="home-view-categories" class="eq-btn eq-btn-pill eq-home-toggle-btn">
			{t(locale, 'home.categories')}
		</label>
		<label for="home-view-types" class="eq-btn eq-btn-pill eq-home-toggle-btn">
			{t(locale, 'design.content.home.types')}
		</label>
	</div>

	<section
		id="home-panel-categories"
		aria-labelledby="categories-heading"
		class="eq-home-panel eq-home-panel-categories"
	>
		<h2 id="categories-heading" class="sr-only">{t(locale, 'home.categories')}</h2>
		<ul class="eq-home-grid">
			{
				categories.map((category) => (
					<li>
						<a
							href={localePath(locale, `/categories/${category.slug}/`)}
							class={`eq-home-card eq-accent-panel cat-${category.slug}`}
						>
							<div class="eq-home-card-body">
								<h3 class="eq-home-card-title">{category.name}</h3>
								{category.lead !== undefined && <p class="eq-home-card-text">{category.lead}</p>}
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section
		id="home-panel-types"
		aria-labelledby="browse-heading"
		class="eq-home-panel eq-home-panel-types"
	>
		<h2 id="browse-heading" class="sr-only">{t(locale, 'home.browse')}</h2>
		<ul class="eq-home-grid">
			{
				collectionCards.map((card) => (
					<li>
						<a
							href={localePath(locale, card.href)}
							class={`eq-home-card eq-accent-panel ${card.accent}`}
						>
							<div class="eq-home-card-body">
								<h3 class="eq-home-card-title">{card.title}</h3>
								<p class="eq-home-card-text">{card.description}</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
