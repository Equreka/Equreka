---
import { type Locale, t } from '@equreka/core/i18n';
import OfflineReader from '../islands/offline-reader';
import BaseLayout from '../layouts/base-layout.astro';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<BaseLayout
	title={`${t(locale, 'offline.title')} — Equreka`}
	description={t(locale, 'meta.offline')}
	locale={locale}
>
	<header class="eq-tool-header">
		<h1>{t(locale, 'offline.title')}</h1>
		<p class="eq-lead">{t(locale, 'offline.lead')}</p>
	</header>
	<OfflineReader client:load locale={locale} />
</BaseLayout>
