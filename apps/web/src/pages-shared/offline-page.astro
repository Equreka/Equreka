---
import { type Locale, t } from '@equreka/core/i18n';
import OfflineReader from '../islands/offline-reader';
import BaseLayout from '../layouts/base-layout.astro';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<BaseLayout
	title={`${t(locale, 'offline.title')} — Equreka`}
	description={t(locale, 'meta.offline')}
	locale={locale}
>
	<h1 class="text-3xl font-bold tracking-tight">{t(locale, 'offline.title')}</h1>
	<p class="mt-2 max-w-2xl text-ink-muted">{t(locale, 'offline.lead')}</p>
	<OfflineReader client:load locale={locale} />
</BaseLayout>
