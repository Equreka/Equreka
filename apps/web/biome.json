{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"root": false,
	"extends": "//",
	"overrides": [
		{
			"includes": ["src/pages/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
